# ── Required ──────────────────────────────────────────────────────────────────
API_KEY=
API_SECRET=
LIVE_TRADING_ENABLED=false   # set to true to allow order placement

# Neon (or any PostgreSQL) connection string.
# Standard postgresql:// URLs are accepted; the app switches to psycopg internally.
DB_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ── Optional overrides (defaults shown) ───────────────────────────────────────
EXCHANGE_BASE_URL=https://mock-api.roostoo.com
LOG_FILE=/app/logs/quant-bot.log
POLL_INTERVAL_SECONDS=120

# Position limits
MAX_OPEN_POSITIONS=15        # hard cap on simultaneous holdings (9999 = unlimited)
MIN_BUY_SCORE=1.5            # minimum opportunity score to enter a trade (0–∞)

# Strategy knobs
FAST_EMA_PERIOD=8
SLOW_EMA_PERIOD=21
RSI_PERIOD=14
MIN_HISTORY=25               # ticks needed before signals fire (~50 min at 2-min polls)
CONFIRM_TICKS=3              # EMA ticks above slow before a BUY is valid
MIN_HOLD_CYCLES=6            # minimum cycles before EMA-sell is allowed
STAGNANT_EXIT_CYCLES=12      # cycles before stagnant exit fires (overridden by market state)
STOP_LOSS_PCT=3.0            # soft stop: only fires when EMA also confirms reversal
TAKE_PROFIT_PCT=3.0          # base take-profit (overridden per market state)
LOSS_COOLDOWN_CYCLES=3       # cycles to wait after a losing sell before buying again

# Sizing
BASE_POSITION_PCT=0.034      # half-Kelly base (~3.4% of portfolio per trade)
MAX_POSITION_PCT=0.10        # hard cap per position (10% of portfolio)
RESERVE_PCT=0.05             # always keep 5% of available cash undeployed
MIN_ORDER_USD=10.0
